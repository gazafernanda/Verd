{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Verd Frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "Verd API (.NET)",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "Verd.Api"],
      "port": 5000
    },
    {
      "name": "PostgreSQL (Docker)",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "-d"],
      "port": 5432
    }
  ]
}
